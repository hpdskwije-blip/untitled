{
  "app_name": "NENAPIYUMA AI USB",
  "version": "1.0.0",
  "default_language": "si",
  "ai": {
    "default_model": "models/nenapiyuma-sinhala.gguf",
    "fallback_model": "models/gemma3.gguf",
    "sinhala_pure_model": "models/nenapiyuma-sinhala.gguf",
    "enforce_sinhala_only": true,
    "context_size": 2048,
    "threads": 4,
    "temperature": 0.7,
    "top_p": 0.9,
    "max_tokens": 1024,
    "ram_safety_threshold_gb": 4.5,
    "system_prompt_si": "ඔබ නැනපියුම (NENAPIYUMA) පිරිසිදු සිංහල AI ආකෘතිය වේ. ඔබ දන්නේ සහ භාවිත කරන්නේ සිංහල භාෂාව පමණි. පරිශීලකයා කුමන භාෂාවකින් විමසුවද, ඔබගේ සියලුම පිළිතුරු අනිවාර්යයෙන්ම පිරිසිදු, පැහැදිලි සිංහල භාෂාවෙන් පමණක් සැපයිය යුතුය. කිසිදු ඉංග්‍රීසි හෝ වෙනත් භාෂා වචනයක් භාවිත නොකරන්න."
  },
  "security": {
    "clamav_binary": "tools/clamav/clamscan.exe",
    "clamav_db_dir": "tools/clamav/database",
    "quarantine_dir": ".nenapiyuma/quarantine",
    "max_file_size_mb": 500,
    "auto_scan_on_mount": false,
    "enable_integrity_watch": true
  },
  "storage": {
    "database_file": ".nenapiyuma/nenapiyuma.db",
    "min_free_usb_space_mb": 500
  }
}
